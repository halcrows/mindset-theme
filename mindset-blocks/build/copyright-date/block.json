{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mindset-blocks/copyright-date",
  "version": "0.1.0",
  "title": "Mindset Blocks",
  "category": "text",
  "icon": "calendar",
  "description": "Display a copyright date",
  "example": {},
  "supports": {
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true
    },
    "color": {
      "text": true,
      "background": true,
      "gradients": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "attributes": {
    "startingYear": {
      "type": "number",
      "default": 2020
    }
  },
  "textdomain": "copyright-date",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}